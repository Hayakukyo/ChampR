import { VerticalBox, HorizontalBox, ListView, Button, CheckBox, ComboBox } from "std-widgets.slint";

export struct SourceModel {
    index: int,
    label: string,
    value: string,
    mode: string,
    selected: bool,
}

export struct RuneModel {
    /// Display index (for identification in callbacks)
    index: int,
    name: string,
    position: string,
    pick-count: int,
    win-rate: string,
    primary-style-id: int,
    sub-style-id: int,
}

// ---------------------------------------------------------------------------
//  SourcesWindow – source selection, Apply Builds, LCU status
// ---------------------------------------------------------------------------

export component SourcesWindow inherits Window {
    title: "ChampR";
    preferred-width: 520px;
    preferred-height: 700px;

    // --- properties ---
    in-out property <string> status: "loading";          // "loading" | "success" | "error"
    in-out property <string> lcu-status: "disconnected"; // "disconnected" | "authorizing" | "needs-admin" | "connected"
    in-out property <string> lcu-summoner: "";
    in-out property <bool> applying-builds: false;
    in-out property <string> apply-status: "";
    in-out property <[SourceModel]> sources;
    in-out property <bool> has-selected-sources: false;

    // --- callbacks ---
    callback apply-builds-clicked();
    callback source-toggled(int, bool);
    callback select-all-sources();
    callback clear-sources();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "ChampR";
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: "Builds, runes, all in one";
            font-size: 13px;
            horizontal-alignment: center;
            color: #888888;
        }

        HorizontalBox {
            spacing: 8px;
            alignment: center;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.lcu-status == "connected" ? #22cc44 : #cc3333;
            }
            Text {
                text: root.lcu-status == "connected"
                    ? "League Client: " + root.lcu-summoner
                    : root.lcu-status == "authorizing"
                    ? "League Client detected. Requesting admin access..."
                    : root.lcu-status == "needs-admin"
                    ? "League Client detected. Admin access is required once to read LCU credentials."
                    : "League Client not detected";
                font-size: 13px;
                color: root.lcu-status == "connected"
                    ? #22cc44
                    : root.lcu-status == "authorizing"
                    ? #cc9a22
                    : root.lcu-status == "needs-admin"
                    ? #cc9a22
                    : #cc3333;
                vertical-alignment: center;
            }
        }

        if root.status == "loading" : HorizontalBox {
            alignment: center;
            Text {
                text: "Loading champion and source data…";
                font-size: 14px;
                color: #888888;
            }
        }

        if root.status == "error" : Text {
            text: "Failed to load champion data. Check your network.";
            font-size: 14px;
            horizontal-alignment: center;
            color: #cc3333;
        }

        if root.status == "success" : VerticalBox {
            spacing: 8px;

            HorizontalBox {
                spacing: 8px;
                Text {
                    text: "Build sources";
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "All";
                    clicked => { root.select-all-sources(); }
                }
                Button {
                    text: "Clear";
                    clicked => { root.clear-sources(); }
                }
            }

            ListView {
                height: 290px;
                for source[index] in root.sources : Rectangle {
                    height: 42px;
                    border-width: 1px;
                    border-color: #eeeeee;
                    border-radius: 5px;
                    background: #fafafa;

                    HorizontalBox {
                        padding: 7px;
                        spacing: 8px;
                        CheckBox {
                            text: source.label;
                            checked: source.selected;
                            toggled => {
                                root.source-toggled(source.index, self.checked);
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: source.mode;
                            font-size: 11px;
                            color: #999999;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        HorizontalBox {
            alignment: center;
            spacing: 12px;

            Button {
                text: root.applying-builds ? "Applying…" : "Apply Builds";
                enabled: !root.applying-builds
                    && root.lcu-status == "connected"
                    && root.has-selected-sources;
                clicked => {
                    root.apply-builds-clicked();
                }
            }
        }

        if !root.has-selected-sources && root.status == "success" : Text {
            text: "Select at least one source.";
            font-size: 12px;
            horizontal-alignment: center;
            color: #999999;
        }

        if root.apply-status != "" : Text {
            text: root.apply-status;
            font-size: 13px;
            horizontal-alignment: center;
            color: #666666;
        }
    }
}

// ---------------------------------------------------------------------------
//  RunesWindow – champion runes overlay with source picker + apply buttons
// ---------------------------------------------------------------------------

export component RunesWindow inherits Window {
    title: "Runes";
    preferred-width: 500px;
    preferred-height: 660px;

    // --- properties ---
    in-out property <int> champion-id: 0;
    in-out property <string> champion-name: "";
    in-out property <image> champion-avatar;
    in-out property <bool> has-champion: false;
    in-out property <[RuneModel]> runes;
    in-out property <string> rune-status: "";
    in-out property <string> apply-rune-status: "";
    in-out property <[string]> rune-source-labels;
    in-out property <string> rune-source-label: "";

    // --- callbacks ---
    callback close-requested();
    callback apply-rune-clicked(int);
    callback rune-source-selected(string);

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        if root.has-champion : HorizontalBox {
            spacing: 12px;
            alignment: center;

            Image {
                source: root.champion-avatar;
                width: 64px;
                height: 64px;
            }

            VerticalBox {
                alignment: center;
                Text {
                    text: root.champion-name != "" ? root.champion-name : "Champion " + root.champion-id;
                    font-size: 22px;
                    font-weight: 600;
                }
            }
        }

        if root.has-champion : HorizontalBox {
            spacing: 8px;
            alignment: center;

            Text {
                text: "Rune source:";
                font-size: 14px;
                vertical-alignment: center;
            }
            ComboBox {
                model: root.rune-source-labels;
                current-value <=> root.rune-source-label;
                selected(value) => {
                    root.rune-source-selected(value);
                }
            }
        }

        if root.rune-status == "loading" : Text {
            text: "Loading runes…";
            font-size: 14px;
            horizontal-alignment: center;
            color: #888888;
        }

        if root.rune-status == "error" : Text {
            text: "Failed to load runes for this champion/source.";
            font-size: 14px;
            horizontal-alignment: center;
            color: #cc3333;
        }

        if root.rune-status == "success" : ListView {
            for rune[index] in root.runes : Rectangle {
                border-width: 1px;
                border-color: #dddddd;
                border-radius: 6px;
                background: #fafafa;
                height: 72px;

                HorizontalBox {
                    padding: 8px;
                    spacing: 8px;
                    alignment: stretch;

                    VerticalBox {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: rune.name != "" ? rune.name : rune.position;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }

                        HorizontalBox {
                            spacing: 12px;
                            Text {
                                text: "Picks: " + rune.pick-count;
                                font-size: 12px;
                                color: #666666;
                            }
                            Text {
                                text: "WR: " + rune.win-rate;
                                font-size: 12px;
                                color: #666666;
                            }
                        }

                        Text {
                            text: rune.position;
                            font-size: 11px;
                            color: #999999;
                        }
                    }

                    VerticalBox {
                        alignment: center;
                        Button {
                            text: "Apply";
                            clicked => {
                                root.apply-rune-clicked(rune.index);
                            }
                        }
                    }
                }
            }
        }

        if root.apply-rune-status != "" : Text {
            text: root.apply-rune-status;
            font-size: 13px;
            horizontal-alignment: center;
            color: #666666;
        }

        HorizontalBox {
            alignment: center;
            Button {
                text: "Close";
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}
